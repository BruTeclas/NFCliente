    {
      "parameters": {
        "jsCode": "// Junta cada pergunta do cliente com a(s) resposta(s) que vieram depois.\n// Tira dados pessoais antes de gravar (LGPD).\nconst conversa = $('Configuração').first().json.conversa_id;\nconst msgs = ($input.first().json.payload || [])\n  .filter(m => !m.private && (m.message_type === 0 || m.message_type === 1) && (m.content || '').trim())\n  .sort((a, b) => a.created_at - b.created_at);\n\nconst limpar = t => t\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g, '[email]')\n  .replace(/\\b\\d{3}\\.?\\d{3}\\.?\\d{3}-?\\d{2}\\b/g, '[cpf]')\n  .replace(/\\b\\d{2}\\.?\\d{3}\\.?\\d{3}\\/?\\d{4}-?\\d{2}\\b/g, '[cnpj]')\n  .replace(/(\\+?55\\s?)?\\(?\\d{2}\\)?\\s?9?\\d{4}[-\\s]?\\d{4}\\b/g, '[telefone]')\n  .replace(/\\s+/g, ' ').trim();\n\nconst saida = [];\nlet perg = [], resp = [];\nconst fechar = () => {\n  if (perg.length && resp.length) {\n    saida.push({ json: {\n      data: new Date().toISOString().slice(0, 10),\n      conversa_id: String(conversa),\n      pergunta: limpar(perg.join(' ')),\n      resposta: limpar(resp.join(' ')),\n      processado: 'não',\n    }});\n  }\n  perg = []; resp = [];\n};\nfor (const m of msgs) {\n  if (m.message_type === 0) { if (resp.length) fechar(); perg.push(m.content); }\n  else if (perg.length) resp.push(m.content);\n}\nfechar();\nreturn saida;"
      },
