    {
      "parameters": {
        "jsCode": "// Converte a resposta da IA no texto que será acrescentado ao Doc.\nconst bruto = $input.first().json.content?.[0]?.text || '{\"entradas\":[]}';\nlet entradas = [];\ntry {\n  entradas = JSON.parse(bruto.replace(/^```(?:json)?\\s*|\\s*```$/g, '').trim()).entradas || [];\n} catch (e) {\n  throw new Error('A IA não devolveu JSON válido: ' + bruto.slice(0, 300));\n}\nentradas = entradas.filter(e => e.pergunta && e.resposta);\n\nconst hoje = new Date().toISOString().slice(0, 10);\nconst texto = entradas.map(e =>\n  `\\nP: ${e.pergunta}\\nR: ${e.resposta}\\nTema: ${e.tema || 'Geral'} · vista ${e.ocorrencias || 1}x · incluída em ${hoje}\\n`\n).join('');\n\nreturn [{ json: { novas: entradas.length, texto } }];"
      },
